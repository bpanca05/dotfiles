{
  "logo": {
    // "source": "~/.config/fastfetch/copland.txt",
    "source": "~/.config/fastfetch/rhinelab.txt",
    "type": "file-raw"
  },
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "modules": [
    {
      "type": "custom",
      // "format": "Let's all love Lain!"
      "format": "Think Different, Solve Intelligence"
    },
    "separator",
    {
      "type": "os",
      "key": "Operating System",
      "format": "{pretty-name}"
    },
    {
      "type" : "host",
      "key": "Machine",
      "format" : "{version}"
    },
    "kernel",
    // {
    //   "type": "shell",
    //   "format": "{exe-path}",
    // },
    "separator",
    "de",
    "wm",
    "separator",
    "uptime",
    "separator",
    {
      "type": "initsystem",
      "format": "{name}"
    },
    {
    "type": "terminalfont",
    "key": "Font",
    "format": "{name}"
    },
    "separator",
    //    {
    //      "type": "colors",
    //      "symbol": "block",
    //      "block": {
    //        "range": [1,7],
    //        "width": 4
    //      }
    //    },
    //    "break",
    {
      "type": "custom",
      "key": " ",
      "format": "Simple by Default, Powerful when Needed"
      // "format": "おはよう、ドクター!",

      // "type" : "command"
      // "text": "bash ~/.config/fastfetch/text",
    }
    // "separator"
  ]
}
