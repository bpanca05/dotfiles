{
  "logo" : {
      // "source": "~/.config/fastfetch/copland.txt",
      "source": "~/.config/fastfetch/rhinelab.txt",
      "type": "file-raw"
  },
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "modules": [
    {
      "type": "custom",
      // "format": "Let's all love Lain!"
      "format": "Think Different, Solve Intelligence"
    },
    "separator",
    {
      "type": "os",
      "format": "{pretty-name}"
    },
    "host",
    "kernel",
    {
      "type": "shell",
      "format": "{exe-path}"
    },
    "wm",
    "separator",
    {
      "type": "initsystem",
      "format": "{name}"
    },
    "uptime",
    {
      "type": "custom",
      "key": "Font",
      "format": "HexaMono"
    },
    "separator",
//    {
//      "type": "colors",
//      "symbol": "block",
//      "block": {
//        "range": [1,7],
//        "width": 4
//      }
//    },
//    "break",
    {
      "type": "custom",
      "key": " ",
      "format": "おはよう、ドクター!"

      // "type" : "command"
      // "text": "bash ~/.config/fastfetch/text",
    },
    "separator"
  ]
}
